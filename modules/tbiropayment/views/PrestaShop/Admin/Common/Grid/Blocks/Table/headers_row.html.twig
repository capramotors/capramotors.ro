<tr class="column-headers {% if grid.attributes.is_empty_state %}d-none{% endif %}">
  {% for column in grid.columns %}
    <th scope="col">
      {{ column_header(column, grid) }}
    </th>
  {% endfor %}
    {% if app.request.attributes.get('_controller') == "PrestaShopBundle\\Controller\\Admin\\Sell\\Order\\OrderController::indexAction" %}
    <th>{{ 'tbi bank Status'|trans({}, 'Modules.Tbiropayment.Admin') }}</th>
    {% endif %}
</tr>
